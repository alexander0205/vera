# ─── Base de datos (Neon, Supabase o cualquier Postgres) ─────────────────────
# Nota: debe ser .env (no .env.local) para que drizzle-kit lo encuentre
POSTGRES_URL=postgresql://user:password@host:5432/emitedo

# ─── Auth (JWT session — el starter maneja esto internamente) ─────────────────
# Genera un secreto aleatorio: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-largo

# ─── Stripe (pagos y suscripciones) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs — obtener desde el Stripe Dashboard (Products > Prices)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_INVOICE=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_PRO=price_...

# ─── App ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:3000

# ─── DGII (ambiente por defecto) ─────────────────────────────────────────────
# Valores: TesteCF | CerteCF | eCF
# En Vercel: production → eCF | preview → CerteCF | development → TesteCF
DGII_ENVIRONMENT=TesteCF

# ─── Identidad del Proveedor de Servicios FE (Yisrael Technology SRL) ────────
# Estos valores aparecen en el formulario de postulación DGII del cliente.
# NUNCA hardcodear en código — leer siempre desde aquí.
PROVIDER_RNC=1333307391
PROVIDER_RAZON_SOCIAL=Yisrael Technology SRL
PROVIDER_NOMBRE_COMERCIAL=EmiteDO
SOFTWARE_NAME=EmiteDO

# ─── URL pública de la API (sin trailing slash) ───────────────────────────────
# En producción: https://api.emitedo.com
# La URL de recepción DGII será: ${NEXT_PUBLIC_APP_URL}/api/dgii/v1/{token}
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cifrado de certificados (AES-256-GCM) ────────────────────────────────────
# Genera UNA SOLA VEZ y nunca cambies (o perderás acceso a todos los certs):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Agregar también en Vercel Dashboard → Settings → Environment Variables
CERT_MASTER_KEY=

# ─── ECF API (proveedor de NCF electrónicos) ──────────────────────────────────
# URL base del servicio ECF (sin trailing slash)
ECF_API_URL=http://localhost:3010
# API Key generada en el panel de administración de ECF API
ECF_API_KEY=ecfk_live_...
# Ambiente DGII para el wizard de habilitación.
# dev → TesteCF | prod → CerteCF  (OBLIGATORIO para habilitación real con DGII)
ECF_HABILITACION_AMBIENTE=CerteCF

# ── Módulos por subdominio (F1) ─────────────────────────────────────────────
# Prod: pos.zero.com.do + facturacion.zero.com.do sobre el mismo deploy.
# SESSION_COOKIE_DOMAIN comparte la sesión entre subdominios (SSO).
# En dev déjalos vacíos: los módulos caen a /pos y /dashboard en localhost.
# POS_HOST=pos.zero.com.do
# FACTURACION_HOST=facturacion.zero.com.do
# SESSION_COOKIE_DOMAIN=.zero.com.do
# NEXT_PUBLIC_POS_URL=https://pos.zero.com.do
# NEXT_PUBLIC_FACTURACION_URL=https://facturacion.zero.com.do

# ── Billing por módulo (F5) — precios Stripe de cada módulo ─────────────────
# Sin estos, la activación de módulos es manual (admin) y POST /api/modulos
# responde 409. Crear products/prices en Stripe y pegar los IDs.
# STRIPE_PRICE_MODULO_FACTURACION=price_...
# STRIPE_PRICE_MODULO_POS=price_...

# ── WhatsApp — API pública de crm-escolar ───────────────────────────────────
# docs/superpowers/specs/2026-08-03-whatsapp-conexion-envio-design.md
# Sin CRM_ZERO_PARTNER_KEY, "Conectar WhatsApp" responde 503.
# La partner key se genera UNA SOLA VEZ en crm-escolar (openssl rand -hex 32)
# y se configura ahí como env var — no se regenera cada vez.
CRM_ZERO_API_URL=https://crm.zero.com.do/api/v1
CRM_ZERO_PARTNER_KEY=

# ── Alertas Slack + Email (Set de Pruebas con errores) ──────────────────────
SLACK_WEBHOOK_URL=
# Lista separada por comas. Sin esto NO se envía la alerta por correo (queda
# un warning en el log); no hay lista por defecto en el código.
HABILITACION_ALERT_EMAIL=

# WhatsApp de soporte (solo dígitos con código de país). Sin esto, las pantallas
# de ayuda enseñan solo el correo — nunca un número inventado.
NEXT_PUBLIC_SOPORTE_WHATSAPP=18097580266

# Buzón donde caen las solicitudes de demo del sitio público.
CONTACTO_EMAIL=hola@zero.com.do

# ── Google Analytics (solo la web pública) ─────────────────────────────────
# Identificador de GA4, con la forma G-XXXXXXXXXX. VACÍO = no se carga nada de
# Google: en desarrollo y en las vistas previas conviene dejarlo así, o las
# visitas de prueba ensucian el informe de verdad.
#
# La etiqueta se monta a mano en los marcos de marketing, legales y acceso —no
# en el layout raíz—, así que NO mide el panel, el punto de venta, el módulo
# escolar ni las rutas cuyo camino es un secreto (/pagar, /pay, /d, /f, /foto).
# De la query solo salen los parámetros de campaña; ver lib/config/analytics.ts.
NEXT_PUBLIC_GA_ID=
