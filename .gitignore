# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (broad — captura cualquier variante con secretos)
.env
.env.*
!.env.example
!.env.*.example
*.bak

# volcados de base de datos — NUNCA al repo
# Traen datos reales de clientes (RNC, correos, montos, comprobantes fiscales).
# Un `git add -A` con un dump suelto los sube a GitHub, y del historial de git
# no se quitan con un commit encima: hay que reescribir el historial entero.
# Por eso van por patrón y no por carpeta: el dump aparece donde caiga.
db-backups/
*.dump
*.sql
*.sql.gz
*.pgdump
!lib/db/migrations/*.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.vscode

# Docker
postgres_data/

# Database seed dumps (contienen datos reales — distribuir por canal seguro, nunca commitear)
scripts/db-seed/*.dump
output/
.claude/worktrees/
.claude/scheduled_tasks.lock

# tunnel logs (cloudflared / localtunnel runtime output)
.cloudflared.*
.localtunnel.*

# debug script ad-hoc (query roles por email — no genérico, no parte del producto)
scripts/check-user-role.ts
scripts/check-cert-status.ts

.claire/

# Playwright artifacts
test-results/
playwright-report/

.release-notes.md

# Capturas de QA (evidencia local, no versionar)
test-results/

# scratch de sesiones de trabajo (temporales de codex + transcripciones de audio)
.codex_tmp/
transcripciones/

# docs de trabajo en curso (borradores locales, no parte del producto)
docs/plan-contabilidad-vera.md
docs/mini-plan-contabilidad-asientos-reportes.md
docs/mockup-cuentas-por-cobrar-paso-1.html

# worktrees locales de git (superpowers:using-git-worktrees)
.worktrees/

# mockups locales del brainstorming visual (superpowers:brainstorming)
.superpowers/

# artefactos locales del análisis de audio/video de WhatsApp (frames, venv de whisper)
.tmp-video-audio-*/
transcripciones/video_frames_*/
