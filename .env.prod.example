# Plantilla para correr la app contra la DB de PRODUCCIÓN.
# Copia a `.env.prod` (gitignored) y pon la URL real:
#   cp .env.prod.example .env.prod
#
# Luego: pnpm dev:prod   (o pnpm start:prod para modo producción real)
#
# Solo POSTGRES_URL es obligatorio aquí — el resto de la config sale de `.env`.
# ⚠️  Las escrituras desde la app afectan datos reales de producción.

POSTGRES_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require&channel_binding=require"
